APP_NAME="QR Order Pager SaaS"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=qr_pager_saas
DB_USERNAME=root
DB_PASSWORD=
# For remote databases, download the provider CA certificate and set its path relative to backend/.
# Example: DB_SSL_CA=certs/ca.pem
DB_SSL_CA=
# For serverless deployments, set DB_SSL_CA_CONTENT to the complete PEM certificate.
DB_SSL_CA_CONTENT=

VAPID_SUBJECT="mailto:admin@qrpager.io"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

SESSION_LIFETIME=86400
RATE_LIMIT_PER_MINUTE=120
